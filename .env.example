# Discord bot token (Developer Portal > Bot)
DISCORD_TOKEN=your-bot-token
# Application ID (Developer Portal > General Information)
CLIENT_ID=your-application-id

# Optional: register commands to one server instantly (otherwise global, can take up to an hour)
GUILD_ID=

# Optional: role given to people when they link
VERIFIED_ROLE_ID=

# Optional: channel to ping in if a user's DMs are closed
FALLBACK_CHANNEL_ID=

# Long random string. Must match the one in your Roblox script.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me

# Port the web API listens on
PORT=3000
